from fastapi import FastAPI, BackgroundTasks
from pydantic import BaseModel, Field
from dotenv import load_dotenv
import os, json, base64
from app.llm_generator import generate_app_code, decode_attachments
from app.github_utils import (
    create_repo,
    create_or_update_file,
    enable_pages,
    generate_mit_license,
    create_or_update_binary_file
)
from app.notify import notify_evaluation_server

# Load environment variables
load_dotenv()
USER_SECRET = os.getenv("USER_SECRET")
USERNAME = os.getenv("GITHUB_USERNAME")
PROCESSED_PATH = "/tmp/processed_requests.json"

app = FastAPI(
    title="TDS Project 1 API",
    description="Handles code generation, GitHub repo creation, and evaluation notification.",
    version="1.0.0"
)

# === Request Schema for Swagger ===
class Attachment(BaseModel):
    name: str
    url: str

class RequestData(BaseModel):
    secret: str = Field(..., description="Secret key to verify the request.")
    email: str = Field(..., description="Student or user email.")
    task: str = Field(..., description="Unique task ID.")
    round: int = Field(..., description="Round number (1 or 2).")
    nonce: str = Field(..., description="Random unique nonce for request validation.")
    evaluation_url: str = Field(..., description="Callback URL for evaluation server.")
    brief: str = Field(..., description="Brief description of the app to generate.")
    attachments: list[Attachment] = Field(default_factory=list)
    checks: list[str] = Field(default_factory=list)

# === Local persistence ===
def load_processed():
    if os.path.exists(PROCESSED_PATH):
        try:
            return json.load(open(PROCESSED_PATH))
        except json.JSONDecodeError:
            return {}
    return {}

def save_processed(data):
    json.dump(data, open(PROCESSED_PATH, "w"), indent=2)

# === Background processing ===
def process_request(data: dict):
    round_num = data.get("round", 1)
    task_id = data["task"]
    print(f"⚙ Starting background process for task {task_id} (round {round_num})")

    attachments = data.get("attachments", [])
    saved_attachments = decode_attachments(attachments)
    print("Attachments saved:", saved_attachments)

    prev_readme = None
    if round_num == 2:
        try:
            repo = create_repo(task_id)
            readme = repo.get_contents("README.md")
            prev_readme = readme.decoded_content.decode("utf-8", errors="ignore")
            print("📄 Loaded previous README for round 2 context.")
        except Exception:
            prev_readme = None

    gen = generate_app_code(
        data["brief"],
        attachments=attachments,
        checks=data.get("checks", []),
        round_num=round_num,
        prev_readme=prev_readme
    )

    files = gen.get("files", {})
    saved_info = gen.get("attachments", [])

    repo = create_repo(task_id, description=f"Auto-generated app for task: {data['brief']}")

    # Round 1: fresh repo
    if round_num == 1:
        print("🏗 Round 1: Building new repo...")
        for att in saved_info:
            try:
                with open(att["path"], "rb") as f:
                    content_bytes = f.read()
                if att["mime"].startswith("text") or att["name"].endswith((".md", ".csv", ".json", ".txt")):
                    text = content_bytes.decode("utf-8", errors="ignore")
                    create_or_update_file(repo, att["name"], text, f"Add attachment {att['name']}")
                else:
                    create_or_update_binary_file(repo, att["name"], content_bytes, f"Add binary {att['name']}")
            except Exception as e:
                print("⚠ Attachment commit failed:", e)
    else:
        print("🔁 Round 2: Updating existing repo...")
        for fname, content in files.items():
            create_or_update_file(repo, fname, content, f"Update {fname} for round 2")

    # Common: write files
    for fname, content in files.items():
        create_or_update_file(repo, fname, content, f"Add/Update {fname}")

    mit_text = generate_mit_license()
    create_or_update_file(repo, "LICENSE", mit_text, "Add MIT license")

    if round_num == 1:
        pages_ok = enable_pages(task_id)
        pages_url = f"https://{USERNAME}.github.io/{task_id}/" if pages_ok else None
    else:
        pages_url = f"https://{USERNAME}.github.io/{task_id}/"

    try:
        commit_sha = repo.get_commits()[0].sha
    except Exception:
        commit_sha = None

    payload = {
        "email": data["email"],
        "task": data["task"],
        "round": round_num,
        "nonce": data["nonce"],
        "repo_url": repo.html_url,
        "commit_sha": commit_sha,
        "pages_url": pages_url,
    }

    notify_evaluation_server(data["evaluation_url"], payload)

    processed = load_processed()
    key = f"{data['email']}::{data['task']}::round{round_num}::nonce{data['nonce']}"
    processed[key] = payload
    save_processed(processed)

    print(f"✅ Finished round {round_num} for {task_id}")

# === Main endpoint ===
@app.post("/api-endpoint")
async def receive_request(data: RequestData, background_tasks: BackgroundTasks):
    data_dict = data.model_dump()
    print("📥 Received request:", data_dict)

    if data_dict.get("secret") != USER_SECRET:
        print("⛔ Invalid secret received.")
        return {"error": "Invalid secret"}

    processed = load_processed()
    key = f"{data_dict['email']}::{data_dict['task']}::round{data_dict['round']}::nonce{data_dict['nonce']}"

    if key in processed:
        print(f"⚠ Duplicate request detected for {key}. Re-notifying only.")
        prev = processed[key]
        notify_evaluation_server(data_dict.get("evaluation_url"), prev)

app = FastAPI()

        return {"status": "ok", "note": "duplicate handled & re-notified"}

    background_tasks.add_task(process_request, data_dict)
    return {"status": "accepted", "note": f"Processing round {data_dict['round']} started"}
